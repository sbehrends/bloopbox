#!/usr/bin/env bash
#
# The gate, before the commit instead of after it. Same `npm run check` CLAUDE.md asks for —
# format, lint, typecheck, tests — because the whole thing takes about six seconds, which is
# cheaper than noticing in CI ten minutes later.
#
# Committed to the repo and wired up by the `prepare` script in box/software/package.json
# (`git config core.hooksPath .githooks`), so a fresh clone gets it from `npm install`
# without adding husky or any other dependency.
#
# This file stays at the REPO ROOT even though the project it gates lives a directory down.
# `core.hooksPath` resolves a relative path against the top of the working tree, and git runs
# hooks from there — so a hook under box/software/ would simply never be found.
#
# The two halves therefore have different working directories, deliberately:
#   - shell checks run from the repo root, because `git diff --cached` yields root-relative
#     paths and will start returning website/... files as this monorepo grows.
#   - `npm run check` runs inside box/software, which is where package.json lives.
#
# To skip it deliberately:  git commit --no-verify
#
# Caveat worth knowing: this checks the working tree, not the staged snapshot. A commit of
# selected files can still pass here and be broken in isolation. Stashing to test the index
# exactly is a good way to lose work in a hook, so it is not done.
set -uo pipefail

# Where each package lives. One place to change if either ever moves again.
SOFTWARE_DIR="box/software"
WEBSITE_DIR="website"

fail() {
  printf '\n\033[31mpre-commit: %s\033[0m\n' "$1" >&2
  printf 'Fix it, or bypass with: git commit --no-verify\n' >&2
  exit 1
}

# Nothing staged means nothing to check (a bare `git commit --amend` of a message, say).
git diff --cached --quiet && exit 0

STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"

# Shell is a good third of this repo now (deploy/, packaging/, the release scripts) and
# neither prettier nor oxlint looks at it. `bash -n` is a parse check and costs nothing;
# shellcheck runs too when it happens to be installed.
SHELL_FILES="$(printf '%s\n' "${STAGED}" | { grep -E '\.sh$|^\.githooks/' || true; })"
if [[ -n "${SHELL_FILES}" ]]; then
  echo "pre-commit: checking shell scripts"
  while IFS= read -r file; do
    [[ -f "${file}" ]] || continue
    bash -n "${file}" || fail "${file} is not valid bash"
    if command -v shellcheck >/dev/null 2>&1; then
      shellcheck --severity=warning "${file}" || fail "shellcheck flagged ${file}"
    fi
  done <<<"${SHELL_FILES}"
fi

# Relative links across the monorepo, which is the thing that actually rots here — the layout has
# moved once already. Python stdlib only, so this costs nothing and needs no node_modules.
MARKDOWN_FILES="$(printf '%s\n' "${STAGED}" | { grep -E '\.md$' || true; })"
if [[ -n "${MARKDOWN_FILES}" && -x .github/scripts/check-doc-links.py ]]; then
  echo "pre-commit: checking doc links"
  # Every tracked file, not just the staged ones: moving or renaming a document breaks links in
  # files this commit does not touch, and those are exactly the ones nobody thinks to check.
  .github/scripts/check-doc-links.py >/dev/null || {
    .github/scripts/check-doc-links.py || true
    fail "broken relative links in markdown"
  }
fi

# The website is its own package with its own gate. CI runs all of it (typecheck plus a full
# static export); here it is the typecheck alone — two seconds against `next build`'s twenty,
# and it catches what a commit actually gets wrong. Skipped when its node_modules is absent,
# because a clone that has only installed the box should not fail on the site.
WEBSITE_FILES="$(printf '%s\n' "${STAGED}" | { grep -E "^${WEBSITE_DIR}/" || true; })"
if [[ -n "${WEBSITE_FILES}" && -d "${WEBSITE_DIR}/node_modules" ]]; then
  echo "pre-commit: typechecking ${WEBSITE_DIR}"
  (
    cd "${WEBSITE_DIR}" || exit 1
    npm run typecheck --silent || exit 1
  ) || fail "typecheck failed in ${WEBSITE_DIR}"
fi

# Everything below is the box software's gate, so it runs from there. A subshell rather than
# a bare `cd`, so nothing after this block can inherit the wrong directory.
#
# Nothing staged under box/software means the gate has nothing to say — a docs-only or
# website-only commit should not pay six seconds to typecheck the daemon.
if ! printf '%s\n' "${STAGED}" | grep -q "^${SOFTWARE_DIR}/"; then
  printf '\033[32mpre-commit: ok (nothing staged under %s)\033[0m\n' "${SOFTWARE_DIR}"
  exit 0
fi

[[ -d "${SOFTWARE_DIR}" ]] || fail "${SOFTWARE_DIR} is missing — has the layout moved?"

(
  cd "${SOFTWARE_DIR}" || exit 1

  # The cue WAVs are generated rather than committed, and the audio tests need them. A fresh
  # clone has none, so the gate would fail for a reason unrelated to the commit.
  if [[ ! -f src/audio/sounds/pop.wav ]]; then
    echo "pre-commit: audio cues missing — running npm run sounds"
    npm run sounds --silent || exit 1
  fi

  echo "pre-commit: npm run check"
  npm run check --silent || exit 1
) || fail "npm run check failed in ${SOFTWARE_DIR}"

printf '\033[32mpre-commit: ok\033[0m\n'

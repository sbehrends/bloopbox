# One .gitignore for the monorepo. Patterns without a slash match at any depth, so they
# cover box/software/, website/ and anything added later. Patterns WITH a slash are
# anchored to this directory and have to name the package explicitly — that is the trap
# to watch when moving things around.

node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Release artefacts and the SD card image build scratch (a cached Pi OS image lives here)
release/

# Persistent writable device volume (config.json, WhatsApp auth). Never committed.
# Unanchored, so it covers both box/software/data/ in development and /data on the device.
data/

# Generated audio cues (rebuild with `npm run sounds`) and temp recordings.
# Anchored — this path is package-specific and must be updated if the box software moves.
box/software/src/audio/sounds/*.wav
*.ogg

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Never commit: WhatsApp session credentials, device secrets, local overrides
auth_info*/
*.session
.env
.env.*
!.env.example

*.log
.DS_Store
.idea/
.vscode/

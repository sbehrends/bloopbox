# /etc/bloopbox/environment — read by both systemd units.
#
# Written once by install.sh, which fills in @BRIDGE_TOKEN@ with a value generated for this
# device and never overwrites the file again, so re-installing an upgrade keeps it.
# Owned root:bloopbox, mode 0640: it holds the shared secret between the two daemons.
#
# After editing:  sudo systemctl restart bloopbox-hardware bloopbox-whatsapp

# Shared secret for the localhost Socket.io link between the two processes, compared in
# constant time on the /bridge namespace. Both units read it from this one file, so they
# cannot disagree.
BRIDGE_TOKEN=@BRIDGE_TOKEN@

# The persistent volume: parent settings and the WhatsApp credentials. The only writable
# path on disk the daemons are given.
CONFIG_PATH=@DATA_DIR@/config.json
WA_AUTH_DIR=@DATA_DIR@/auth_info

# What each button has sent and received, shown at the top of the settings page. Beside the
# config and deliberately not inside it: a counter in config.json would restart the daemon on
# every button press, and a stats file that will not parse is allowed to cost the totals and
# nothing else. Written coalesced and atomically, like the config.
#
# Named here rather than left to its default only because the default is the literal
# /data/stats.json, which is wrong on a box installed with --data-dir somewhere else. An
# upgrade keeps this file, so a box installed before this line existed falls back to that
# default — correct for every standard install, which is why it is not worth more than this.
STATS_PATH=@DATA_DIR@/stats.json

# Outbound captures and every derived file, in RAM. /run is a tmpfs and systemd creates this
# directory for both units (RuntimeDirectory=bloopbox), so nothing the child records survives
# a power cut or reaches the SD card. Do not point this at a path on disk.
RECORDING_DIR=/run/bloopbox

# Inbound voice notes, on the card, so an arriving note is still waiting after someone unplugs
# the box — the most likely restart in a child's room. Playing a note deletes it and the purge
# sweeps the rest at 48 h, so this is bounded in both directions.
#
# Leaving this unset is fine: the default is this same path. That is deliberate, because an
# upgrade keeps the existing copy of this file, and a box installed before the split has no
# NOTES_DIR line to inherit. Do not "fix" that with a fallback to RECORDING_DIR — it would put
# every such box straight back in RAM.
NOTES_DIR=/data/notes

NODE_ENV=production
# debug is the dev default and is far too chatty for an SD card.
LOG_LEVEL=info

# --- bring-up knobs (src/hal/gpioDriver.ts) -------------------------------------------
# The GPIO driver has never run on real hardware. These are the first things to change.
#
# LEDs on but dark, or dark when they should be on:
#LED_ACTIVE_HIGH=false
#
# Buttons reading pressed when idle (switches wired to 3V3 instead of ground):
#BUTTON_ACTIVE_LOW=false
#
# `arecord -l` / `aplay -l` show a device that is not the default, e.g. a USB speakerphone
# that lands as card 1:
#ALSA_CAPTURE_DEVICE=plughw:1,0
#ALSA_PLAYBACK_DEVICE=plughw:1,0
#
# `amixer scontrols` names the playback control something other than PCM:
#ALSA_MIXER_CONTROL=Speaker
#
# `amixer scontrols` names the capture control something other than Mic (WM8960: Capture):
#ALSA_CAPTURE_MIXER_CONTROL=Capture
#
# Pin names resolve to the wrong lines. Any board opengpio exports; a wrong name fails at
# startup and lists the valid ones. Not needed on a 2B/3B/3B+ — the Zero 2 W map was seen
# claiming the right lines on a real 3B+ on 2026-08-10:
#PI_BOARD=RaspberryPi_3B
#
# ffmpeg somewhere other than the PATH:
#FFMPEG_PATH=/usr/bin/ffmpeg

# --- reduced boards --------------------------------------------------------------------
# The three logical channels always exist above the HAL. These say how many of them have
# hardware behind them, in channel order (left, centre, right). Unset uses all three;
# empty claims none. Fewer buttons than three is a partly-wired board, not an error.
#
# The MVP board — Pi 3B+ with the WM8960 HAT, the HAT's own button on GPIO17 as button 1,
# and no lamps at all — is what `install.sh --audio-hat wm8960 --no-leds` writes:
#BUTTON_PINS=GPIO17
#LED_PINS=

# --- WM8960 audio HAT ------------------------------------------------------------------
# Written by `install.sh --audio-hat wm8960`, which also adds the overlay to config.txt.
# Addressed by card name so a changing card number cannot silently move the daemon onto
# the wrong device. Verify with `sudo bloopbox-audio-test`.
#ALSA_PLAYBACK_DEVICE=plughw:CARD=wm8960soundcard,DEV=0
#ALSA_CAPTURE_DEVICE=plughw:CARD=wm8960soundcard,DEV=0
#
# Capture rate, normally left alone so no resampling happens on a slow CPU. The WM8960 is
# the clock consumer on a shared I2S bit clock and cannot hold two rates at once, and the
# record cues are 48 kHz — the "pop" fires while capture is open. 48000 makes them agree.
#CAPTURE_RATE=48000

# Runs the browser simulator instead of real GPIO — install.sh --simulator sets this. On a
# device with buttons attached, leave it out.
#SIMULATOR_MODE=true

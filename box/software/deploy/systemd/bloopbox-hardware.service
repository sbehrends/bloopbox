[Unit]
# Process 1 of 2 (src/processes/hardware-server.ts): GPIO, LEDs, audio, config, the admin
# panel and the Socket.io server the WhatsApp bridge dials into.
Description=bloopbox — hardware and web server
Documentation=file://@PREFIX@/deploy/doctor.sh
After=network.target sound.target
# Not Requires=: the buttons and the LED error patterns are exactly what should still work
# when the network is down.
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
# gpio: /dev/gpiochip*, via the udev rules Raspberry Pi OS ships. audio: /dev/snd, for
# arecord / aplay / amixer.
SupplementaryGroups=gpio audio
WorkingDirectory=@PREFIX@
EnvironmentFile=@ETC_DIR@/environment

# Saving Wi-Fi settings in the admin panel restarts this unit, so this is where a network
# change is picked up. "+" runs it as root (the daemon itself is unprivileged); "-" means a
# failure to apply never stops the device from starting.
ExecStartPre=-+@PREFIX@/deploy/wifi-apply.sh

ExecStart=@PREFIX@/node/bin/node dist/processes/hardware-server.js

# The captive portal answers on :80, and a phone's connectivity probe will not ask anywhere
# else. This is the whole reason the daemon needs a privileged port; the alternative was an
# nftables redirect that something running as root would have to tear down again.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Saving a setting makes the daemon exit 0 on purpose so the new config is read at boot —
# there is deliberately no live-reload path (see CLAUDE.md). Restart=always is what turns
# that clean exit back into a running device, and covers a crash identically.
Restart=always
RestartSec=1
TimeoutStopSec=10

# Recordings live in RAM and must not survive a power cut. /run is already a tmpfs, so
# this needs no mount unit: systemd creates /run/bloopbox owned by the service user.
# Preserve=yes keeps it across the restart-on-config-save, and across the bridge stopping,
# since both units declare the same directory.
#
# There used to be a RuntimeDirectorySize=64M here. It is not a real per-service directive —
# that name belongs to logind.conf's per-user XDG_RUNTIME_DIR sizing, not RuntimeDirectory=
# in a [Service] section — so systemd silently ignored it on every boot
# ("Unknown key 'RuntimeDirectorySize'..."). There is no systemd knob that caps one
# RuntimeDirectory independent of the rest of /run without a dedicated tmpfs mount unit,
# which both units sharing this same directory makes awkward. What actually bounds it is
# MemoryMax below: on cgroup v2, tmpfs pages are charged to the cgroup of whichever process
# wrote them, so this directory can only grow as far as MemoryMax allows before that
# process hits it — which requires the memory controller to be enabled at all; see
# deploy/install.sh's cmdline.txt step.
RuntimeDirectory=bloopbox
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# Button-to-LED latency is the one thing a two-year-old will notice.
Nice=-5

# 512 MB total on a Pi Zero 2 W, shared with the bridge. MemoryHigh throttles first;
# MemoryMax is the backstop, and Restart=always recovers from an OOM kill. Also what bounds
# /run/bloopbox above, via cgroup-accounted tmpfs pages — and also currently unenforced on
# real hardware unless deploy/install.sh's cmdline.txt step has run: Pi firmware disables
# the memory cgroup controller by default on boards with this little RAM.
MemoryHigh=128M
MemoryMax=192M
Environment=NODE_OPTIONS=--max-old-space-size=128

# Hardening. /data is the only writable path on disk; everything else the daemon needs is
# the RuntimeDirectory above. If bring-up hits an unexplained EACCES, comment this block
# out first — the GPIO and ALSA paths have never run on real hardware.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=@DATA_DIR@
# Deliberately not PrivateTmp: both daemons hand each other file paths for audio.
PrivateTmp=no

[Install]
WantedBy=multi-user.target

[Unit]
# Gives a flashed image its own ssh password on first boot — see deploy/ssh-password.sh.
# Only while the image builder's marker is there, so a tarball install is never touched.
Description=bloopbox — per-device ssh password
ConditionPathExists=@ETC_DIR@/ssh-password.pending
# userconfig.service renames the image's `pi` account; the password belongs to the new name.
After=local-fs.target userconfig.service
# Before sshd can accept a login, and before the daemon that shows the password.
Before=ssh.service sshswitch.service bloopbox-hardware.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@PREFIX@/deploy/ssh-password.sh
Environment=ETC_DIR=@ETC_DIR@ DATA_DIR=@DATA_DIR@ SERVICE_USER=@USER@

[Install]
WantedBy=multi-user.target

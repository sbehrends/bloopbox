{
  "name": "bloopbox",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Screenless WhatsApp voice messenger for kids aged 2-5. Three arcade buttons, hold to send, tap to play.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "run-p dev:hw dev:wa",
    "dev:hw": "tsx scripts/dev-server.ts",
    "dev:wa": "tsx watch src/processes/whatsapp-bridge.ts",
    "dev:web": "vite",
    "build": "run-s build:server build:assets build:web",
    "build:server": "tsc --project tsconfig.build.json",
    "build:assets": "tsx scripts/copy-assets.ts",
    "build:web": "vite build",
    "start:hw": "node dist/processes/hardware-server.js",
    "start:wa": "node dist/processes/whatsapp-bridge.js",
    "typecheck": "run-s typecheck:server typecheck:web",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit --project tsconfig.web.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gate": "vitest run --coverage",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html",
    "doctor": "tsx scripts/doctor.ts",
    "sounds": "tsx scripts/generate-sounds.ts",
    "clean": "rm -rf dist release coverage ./*.tsbuildinfo",
    "clean:all": "npm run clean && rm -rf node_modules && find src/audio/sounds -name '*.wav' -delete",
    "release": "./scripts/build-release.sh",
    "release:smoke": "./scripts/smoke-test-release.sh",
    "release:image": "./scripts/build-sd-image.sh",
    "check": "run-s format:check lint typecheck test:gate",
    "dev:hw:watch": "SIMULATOR_MODE=true tsx watch src/processes/hardware-server.ts"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "qrcode": "1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.6"
  },
  "optionalDependencies": {
    "opengpio": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.10"
  }
}

{
  "name": "kids-whatsapp-messenger",
  "version": "0.1.0",
  "private": true,
  "description": "Screenless WhatsApp voice messenger for kids aged 2-5. Three arcade buttons, hold to send, tap to play.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "run-p dev:hw dev:wa",
    "dev:hw": "tsx scripts/dev-server.ts",
    "dev:wa": "tsx watch src/processes/whatsapp-bridge.ts",
    "dev:web": "vite",
    "build": "run-s build:server build:assets build:web",
    "build:server": "tsc --project tsconfig.build.json",
    "build:assets": "tsx scripts/copy-assets.ts",
    "build:web": "vite build",
    "start:hw": "node dist/processes/hardware-server.js",
    "start:wa": "node dist/processes/whatsapp-bridge.js",
    "typecheck": "run-s typecheck:server typecheck:web",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit --project tsconfig.web.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "doctor": "tsx scripts/doctor.ts",
    "sounds": "tsx scripts/generate-sounds.ts",
    "check": "run-s format:check lint typecheck test",
    "dev:hw:watch": "SIMULATOR_MODE=true tsx watch src/processes/hardware-server.ts"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "qrcode": "1.5.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "opengpio": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}

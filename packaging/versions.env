# Every pinned external artefact in the release pipeline, in one place.
#
# Sourced by scripts/build-release.sh, scripts/smoke-test-release.sh,
# scripts/build-sd-image.sh and the GitHub workflows. Shell syntax only — no expansions
# beyond the variables defined above each line, because CI also reads it with `source`.
#
# ---------------------------------------------------------------------------------------
# Why Trixie (Debian 13 / Raspberry Pi OS 2026-06 or later), 64-bit, and nothing older:
#
#   `opengpio@2.0.2` compiles against the libgpiod *v2* C++ API (`gpiod::line::value`,
#   `line_request::release()`). Bookworm ships libgpiod 1.6.3, where those symbols do not
#   exist, so the native addon fails to build and the device has no GPIO at all. Trixie
#   ships libgpiod 2.2.1 (`libgpiod3` at runtime, `libgpiod-dev` to build), which is what
#   the addon needs. Every current Raspberry Pi OS Lite arm64 image is Trixie anyway.
#
#   32-bit is not a target: Node has no official armv6 build, and the Pi Zero 2 W is a
#   Cortex-A53, so arm64 is both available and faster.
# ---------------------------------------------------------------------------------------

# Builder image. The release bundles *this* image's `node` binary, so the compiled
# opengpio addon and the runtime can never disagree about NODE_MODULE_VERSION.
NODE_IMAGE=node:24.18.1-trixie-slim

# Bare OS image used to smoke-test the artefact — deliberately not the builder image, so
# the test proves the package runs somewhere with no toolchain and no npm.
RUNTIME_IMAGE=debian:trixie-slim

TARGET_ARCH=arm64
TARGET_PLATFORM=linux/arm64
TARGET_OS="Raspberry Pi OS Trixie (64-bit)"

# Installed on the device by deploy/install.sh.
#   ffmpeg      — the Opus/ogg pipeline (src/audio/ffmpeg.ts)
#   alsa-utils  — arecord / aplay / amixer, which the GPIO HAL shells out to
#   libgpiod3   — libgpiod.so.3 + libgpiodcxx.so.2, what opengpio links against
RUNTIME_PACKAGES="ffmpeg alsa-utils libgpiod3"

# Needed only inside the builder, never on the device.
#   build-essential, python3, libgpiod-dev — node-gyp compiling the opengpio addon
#   ffmpeg                                 — `npm run sounds` synthesises the cue WAVs
#                                            through the same Opus pipeline the device uses
BUILD_PACKAGES="build-essential python3 libgpiod-dev ffmpeg"

# Raspberry Pi OS Lite 64-bit. Pinned rather than tracking "latest" so an image build is
# reproducible; bump both lines together and re-run scripts/build-sd-image.sh.
PI_OS_RELEASE=raspios_lite_arm64-2026-06-19
PI_OS_IMAGE=2026-06-18-raspios-trixie-arm64-lite
PI_OS_URL="https://downloads.raspberrypi.com/raspios_lite_arm64/images/${PI_OS_RELEASE}/${PI_OS_IMAGE}.img.xz"
PI_OS_SHA256=acff736ca7945e3b305f07cda4abdb870910e12634991da69783611756e381b3

# How much room to add to the Pi OS root partition before installing into it. The payload
# is the bundled Node runtime plus node_modules plus ffmpeg and friends; Lite leaves well
# under that free. First boot still expands the partition to fill the real card.
IMAGE_GROW_MB=1792

# Defaults baked into a built image. Overridable per build; see scripts/build-sd-image.sh.
IMAGE_HOSTNAME=kids-messenger
IMAGE_USER=kids
